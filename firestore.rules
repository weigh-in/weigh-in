rules_version = '2';
// Weigh-In security rules. Paste this whole file into
// Firebase console > Firestore Database > Rules, then click Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function shortText(t, n) { return t is string && t.size() > 0 && t.size() <= n; }

    // Angler names: one per account, first come first served, can't be stolen.
    match /usernames/{lowerName} {
      allow read: if signedIn();
      allow create: if isMe(request.resource.data.uid)
                    && lowerName.size() >= 2 && lowerName.size() <= 20;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid) && shortText(request.resource.data.name, 20);
      allow delete: if false;

      // Private fishing log: only you can read or write it.
      match /log/{entryId} {
        allow read, write: if isMe(uid);
      }
    }

    // Catches on the feed.
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if isMe(request.resource.data.uid)
                    && shortText(request.resource.data.species, 40)
                    && request.resource.data.photo is string
                    && request.resource.data.photo.size() < 900000;
      allow update: if false;
      allow delete: if isMe(resource.data.uid);

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if isMe(request.resource.data.uid) && shortText(request.resource.data.text, 300);
        allow delete: if isMe(resource.data.uid);
      }
    }

    // Tournaments: anyone can make one; you can only add YOURSELF to members.
    match /tournaments/{tid} {
      allow read: if signedIn();
      allow create: if isMe(request.resource.data.createdBy)
                    && shortText(request.resource.data.name, 40)
                    && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                    && request.resource.data.members.hasAll(resource.data.members)
                    && request.resource.data.members.size() == resource.data.members.size() + 1
                    && request.auth.uid in request.resource.data.members;
      allow delete: if isMe(resource.data.createdBy);
    }

    // Friend requests. ID is fromUid_toUid.
    match /requests/{rid} {
      allow read: if signedIn() && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if isMe(request.resource.data.from)
                    && rid == request.resource.data.from + '_' + request.resource.data.to;
      allow delete: if signedIn() && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
    }

    // Friendships. ID is the two uids sorted and joined with _.
    // You can only create one if the other person sent YOU a request.
    match /friendships/{fid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] < request.resource.data.members[1]
        && fid == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && (
          (request.auth.uid == request.resource.data.members[0]
            && exists(/databases/$(database)/documents/requests/$(request.resource.data.members[1] + '_' + request.auth.uid)))
          ||
          (request.auth.uid == request.resource.data.members[1]
            && exists(/databases/$(database)/documents/requests/$(request.resource.data.members[0] + '_' + request.auth.uid)))
        );
      allow delete: if signedIn() && request.auth.uid in resource.data.members;

      // Chat messages between the two friends only.
      match /messages/{mid} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/friendships/$(fid)).data.members;
        allow create: if isMe(request.resource.data.uid)
          && shortText(request.resource.data.text, 500)
          && request.auth.uid in get(/databases/$(database)/documents/friendships/$(fid)).data.members;
      }
    }
  }
}
